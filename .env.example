# Copy this file to .env before running Docker Compose.
FRONTEND_PORT=3000
BACKEND_PORT=3001
MONGO_PORT=27017

MONGO_ROOT_USERNAME=tiktok
MONGO_ROOT_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-characters

# This URL is used by the visitor's browser, so use a publicly reachable URL
# when deploying to a server (for local Docker, localhost is correct).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Optional Google login configuration.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
